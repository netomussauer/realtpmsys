# ATENÇÃO: este arquivo é apenas um TEMPLATE. Não commitar valores reais.
#
# Como gerar o SealedSecret correto (após ArgoCD/SealedSecrets estarem no cluster):
#
#   1. Pegar a senha do PG (já existe em shared-infra):
#      kubectl -n shared-infra get secret postgresql-secret \
#        -o jsonpath='{.data.REALTPMSYS_PASSWORD}' | base64 -d
#
#   2. Gerar um JWT_SECRET forte:
#      openssl rand -base64 48
#
#   3. Criar Secret em manifest local (NÃO commitar):
#      cat <<EOF > /tmp/realtpmsys-secrets.yaml
#      apiVersion: v1
#      kind: Secret
#      metadata:
#        name: realtpmsys-secrets
#        namespace: realtpmsys
#      type: Opaque
#      stringData:
#        pg-password: "<senha-do-pg-aqui>"
#        jwt-secret:  "<jwt-secret-aqui>"
#      EOF
#
#   4. Selar com kubeseal (chave pública do controller):
#      kubeseal --controller-namespace=cicd \
#               --controller-name=sealed-secrets \
#               --format=yaml < /tmp/realtpmsys-secrets.yaml > sealedsecret.yaml
#
#   5. Apagar o Secret em texto puro:
#      shred -u /tmp/realtpmsys-secrets.yaml
#
#   6. Commitar APENAS o sealedsecret.yaml selado.
#
# O SealedSecret abaixo é só placeholder — substituir antes de aplicar.
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: realtpmsys-secrets
  namespace: realtpmsys
spec:
  encryptedData:
    pg-password: PLACEHOLDER_SUBSTITUIR_POR_VALOR_SELADO
    jwt-secret:  PLACEHOLDER_SUBSTITUIR_POR_VALOR_SELADO
  template:
    metadata:
      name: realtpmsys-secrets
      namespace: realtpmsys
      labels:
        app.kubernetes.io/name: "realtpmsys"
        app.kubernetes.io/component: "config"
        app.kubernetes.io/managed-by: "argocd"
        environment: "dev"
        lab_id: "lab-k8s-01"
        lab_owner: "jose.mussauer"
    type: Opaque
