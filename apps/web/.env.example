# Variáveis de ambiente do apps/web — copie para .env.local em desenvolvimento.
# Nunca commitar .env.local. Em produção (K3s), Secret + envFrom.

# ── Backend Go (URLs) ────────────────────────────────────────────────────────
# URL pública (visível ao cliente — embarcada no bundle JS via NEXT_PUBLIC_).
# Dev local: backend rodando em 8000 OU api.realtpmsys.local resolvido pelo Pi-hole.
NEXT_PUBLIC_API_URL=http://api.realtpmsys.local:8000

# URL interna usada APENAS no server runtime (route handlers BFF).
# Em K3s, prefira DNS de Service ClusterIP: http://realtpmsys-api.realtpmsys.svc.cluster.local:8000
# Em dev, pode ser igual ao público.
INTERNAL_API_URL=http://api.realtpmsys.local:8000

# ── JWT (sincronizado com backend) ──────────────────────────────────────────
# JWT_SECRET DEVE ser EXATAMENTE o mesmo do backend Go (vide config.JWT.Secret).
# Em K3s, é o SealedSecret `realtpmsys-jwt-secret` montado em ambos os Deployments.
# Em dev, ler de `realtpmsys-api/.env` ou setar manualmente.
# Gerar com: openssl rand -base64 64
JWT_SECRET=

# ── Outros ──────────────────────────────────────────────────────────────────
# Permite chamar o backend sem TLS em dev. Em prod, `false`.
ALLOW_INSECURE_API=true
