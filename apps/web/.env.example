# Variáveis de ambiente do apps/web — copie para .env.local em desenvolvimento.

# URL pública do backend Go (visível ao cliente).
# Dev: backend rodando local em 8000 OU lab via DNS (Pi-hole resolve api.realtpmsys.local).
# Prod (K3s): o middleware/BFF resolve via DNS interno do cluster.
NEXT_PUBLIC_API_URL=http://api.realtpmsys.local:8000

# Segredo para assinar o cookie de sessão do BFF route handler.
# Gerar com: openssl rand -base64 32
# Nunca commitar. Em produção, ler de Kubernetes Secret.
SESSION_SECRET=

# Em dev, permite chamar o backend sem TLS. Em prod, deixar `false`.
ALLOW_INSECURE_API=true
